+// ---------------------------------------------------------------------------
+// SHA-1 SSE2 message schedule
+//
+// True 4-wide SSE2: computes four W words at once using 128-bit XMM registers.
+// The round function itself stays scalar because SHA-1 has a serial dependency
+// chain (a→b→c→d→e) that cannot be vectorised across rounds.
+//
+// Algorithm: W[i] = rol(W[i-3] ^ W[i-8] ^ W[i-14] ^ W[i-16], 1)
+//
+// Each XMM register holds 4 consecutive 32-bit words:
+//   w0 = [W[i-16], W[i-15], W[i-14], W[i-13]]   (lane 0 = lowest index)
+//   w1 = [W[i-12], W[i-11], W[i-10], W[i-9 ]]
+//   w2 = [W[i-8 ], W[i-7 ], W[i-6 ], W[i-5 ]]
+//   w3 = [W[i-4 ], W[i-3 ], W[i-2 ], W[i-1 ]]
+// Returns [W[i], W[i+1], W[i+2], W[i+3]].
+//
+// Note on W[i+3]: it depends on W[i] (which we just computed), so a one-shot
+// ROTL1 of the XOR leaves lane 3 incomplete. We fix it afterwards with a
+// second targeted ROTL1 on lane 0 shifted into lane 3.
+// ---------------------------------------------------------------------------
+
+// ROTL1 on all four 32-bit lanes simultaneously.
+static inline __m128i sha1_rotl1_x4(__m128i v) noexcept
+{
+	return _mm_or_si128(_mm_slli_epi32(v, 1), _mm_srli_epi32(v, 31));
+}
+
+// Compute the next four schedule words.
+static inline __m128i sha1_schedule_sse2(
+		__m128i w0, __m128i w1, __m128i w2, __m128i w3) noexcept
+{
+	// W[-3] contribution: [W[i-3], W[i-2], W[i-1], 0]
+	// (_mm_srli_si128 shifts the 128-bit register toward lower addresses by n bytes,
+	//  moving data from higher lanes to lower lanes and zeroing the vacated high lanes)
+	__m128i ws = _mm_srli_si128(w3, 4);
+
+	// W[-14] contribution: [W[i-14], W[i-13], W[i-12], W[i-11]]
+	//   = upper half of w0  ||  lower half of w1
+	__m128i wm14 = _mm_or_si128(
+			_mm_srli_si128(w0, 8),   // [W[i-14], W[i-13], 0,        0       ]
+			_mm_slli_si128(w1, 8));  // [0,        0,        W[i-12], W[i-11] ]
+
+	// XOR all four terms: W[-3]partial ^ W[-8] ^ W[-14] ^ W[-16]
+	__m128i tmp = _mm_xor_si128(
+			_mm_xor_si128(ws,   w2),
+			_mm_xor_si128(wm14, w0));
+
+	// ROTL1 → [W[i], W[i+1], W[i+2], PARTIAL_W[i+3]]
+	// PARTIAL_W[i+3] = rol(W[i-5]^W[i-11]^W[i-13], 1)  ← missing the W[i] term.
+	__m128i result = sha1_rotl1_x4(tmp);
+
+	// Fix lane 3: W[i+3] = rol(W[i] ^ ..., 1)
+	//                     = rol(W[i], 1) ^ rol(..., 1)
+	//                     = rol(W[i], 1) ^ PARTIAL_W[i+3]
+	// W[i] sits in lane 0; shift it to lane 3 (zeroing other lanes) then ROTL1.
+	result = _mm_xor_si128(result,
+			sha1_rotl1_x4(_mm_slli_si128(result, 12)));  // [0,0,0, rol(W[i],1)]
+
+	return result;
+}
+
+// ---------------------------------------------------------------------------
+// SHA-1 block compression with SSE2-accelerated message schedule.
+//
+// IMPORTANT – state storage convention in MAME:
+//   st[0]=H4, st[1]=H3, st[2]=H2, st[3]=H1, st[4]=H0   (reversed)
+//
+// So the correct mapping to the explicit SHA-1 working variables is:
+//   a = st[4] (H0),  b = st[3] (H1),  c = st[2] (H2),
+//   d = st[1] (H3),  e = st[0] (H4)
+//
+// And the final accumulation is:
+//   st[4] += a,  st[3] += b,  st[2] += c,  st[1] += d,  st[0] += e
+//
+// data[] arrives already in host-endian; MAME's append() performs the
+// byte-swap when filling m_buf on little-endian platforms (XOR-3 swizzle).
+// ---------------------------------------------------------------------------
+
+inline void sha1_process_sse2(std::array<uint32_t, 5> &st, uint32_t *data) noexcept
+{
+	// ----- Phase 1: precompute W[i]+K[i] for all 80 rounds via SSE2 -----
+
+	alignas(16) uint32_t WK[80]; // W[i] + K[i], one entry per round
+
+	const __m128i K1 = _mm_set1_epi32(0x5a827999U); // rounds  0-19
+	const __m128i K2 = _mm_set1_epi32(0x6ed9eba1U); // rounds 20-39
+	const __m128i K3 = _mm_set1_epi32(0x8f1bbcdcU); // rounds 40-59
+	const __m128i K4 = _mm_set1_epi32(0xca62c1d6U); // rounds 60-79
+
+	// Load the 16 message words from the block buffer.
+	__m128i w0 = _mm_loadu_si128(reinterpret_cast<const __m128i *>(data +  0));
+	__m128i w1 = _mm_loadu_si128(reinterpret_cast<const __m128i *>(data +  4));
+	__m128i w2 = _mm_loadu_si128(reinterpret_cast<const __m128i *>(data +  8));
+	__m128i w3 = _mm_loadu_si128(reinterpret_cast<const __m128i *>(data + 12));
+
+	// Rounds 0-19  (K1; last 4 come from the first schedule call)
+	_mm_store_si128(reinterpret_cast<__m128i *>(WK +  0), _mm_add_epi32(w0, K1));
+	_mm_store_si128(reinterpret_cast<__m128i *>(WK +  4), _mm_add_epi32(w1, K1));
+	_mm_store_si128(reinterpret_cast<__m128i *>(WK +  8), _mm_add_epi32(w2, K1));
+	_mm_store_si128(reinterpret_cast<__m128i *>(WK + 12), _mm_add_epi32(w3, K1));
+	__m128i w4  = sha1_schedule_sse2(w0, w1, w2, w3);
+	_mm_store_si128(reinterpret_cast<__m128i *>(WK + 16), _mm_add_epi32(w4,  K1));
+
+	// Rounds 20-39  (K2)
+	__m128i w5  = sha1_schedule_sse2(w1, w2, w3, w4);
+	_mm_store_si128(reinterpret_cast<__m128i *>(WK + 20), _mm_add_epi32(w5,  K2));
+	__m128i w6  = sha1_schedule_sse2(w2, w3, w4, w5);
+	_mm_store_si128(reinterpret_cast<__m128i *>(WK + 24), _mm_add_epi32(w6,  K2));
+	__m128i w7  = sha1_schedule_sse2(w3, w4, w5, w6);
+	_mm_store_si128(reinterpret_cast<__m128i *>(WK + 28), _mm_add_epi32(w7,  K2));
+	__m128i w8  = sha1_schedule_sse2(w4, w5, w6, w7);
+	_mm_store_si128(reinterpret_cast<__m128i *>(WK + 32), _mm_add_epi32(w8,  K2));
+	__m128i w9  = sha1_schedule_sse2(w5, w6, w7, w8);
+	_mm_store_si128(reinterpret_cast<__m128i *>(WK + 36), _mm_add_epi32(w9,  K2));
+
+	// Rounds 40-59  (K3)
+	__m128i w10 = sha1_schedule_sse2(w6,  w7,  w8,  w9);
+	_mm_store_si128(reinterpret_cast<__m128i *>(WK + 40), _mm_add_epi32(w10, K3));
+	__m128i w11 = sha1_schedule_sse2(w7,  w8,  w9,  w10);
+	_mm_store_si128(reinterpret_cast<__m128i *>(WK + 44), _mm_add_epi32(w11, K3));
+	__m128i w12 = sha1_schedule_sse2(w8,  w9,  w10, w11);
+	_mm_store_si128(reinterpret_cast<__m128i *>(WK + 48), _mm_add_epi32(w12, K3));
+	__m128i w13 = sha1_schedule_sse2(w9,  w10, w11, w12);
+	_mm_store_si128(reinterpret_cast<__m128i *>(WK + 52), _mm_add_epi32(w13, K3));
+	__m128i w14 = sha1_schedule_sse2(w10, w11, w12, w13);
+	_mm_store_si128(reinterpret_cast<__m128i *>(WK + 56), _mm_add_epi32(w14, K3));
+
+	// Rounds 60-79  (K4)
+	__m128i w15 = sha1_schedule_sse2(w11, w12, w13, w14);
+	_mm_store_si128(reinterpret_cast<__m128i *>(WK + 60), _mm_add_epi32(w15, K4));
+	__m128i w16 = sha1_schedule_sse2(w12, w13, w14, w15);
+	_mm_store_si128(reinterpret_cast<__m128i *>(WK + 64), _mm_add_epi32(w16, K4));
+	__m128i w17 = sha1_schedule_sse2(w13, w14, w15, w16);
+	_mm_store_si128(reinterpret_cast<__m128i *>(WK + 68), _mm_add_epi32(w17, K4));
+	__m128i w18 = sha1_schedule_sse2(w14, w15, w16, w17);
+	_mm_store_si128(reinterpret_cast<__m128i *>(WK + 72), _mm_add_epi32(w18, K4));
+	__m128i w19 = sha1_schedule_sse2(w15, w16, w17, w18);
+	_mm_store_si128(reinterpret_cast<__m128i *>(WK + 76), _mm_add_epi32(w19, K4));
+
+	// ----- Phase 2: 80 scalar rounds using precomputed WK[] -----
+	//
+	// Correct initialisation – state is stored reversed in MAME:
+	//   a = st[4] = H0,  b = st[3] = H1,  c = st[2] = H2,
+	//   d = st[1] = H3,  e = st[0] = H4
+	uint32_t a = st[4], b = st[3], c = st[2], d = st[1], e = st[0];
+
+	// Round step macros (pure scalar – compiler generates optimal code).
+	// F0 = d ^ (b & (c ^ d))          Choice      rounds  0-19
+	// F1 = b ^ c ^ d                  Parity      rounds 20-39
+	// F2 = (b & c) | (d & (b | c))    Majority    rounds 40-59
+	// F3 = b ^ c ^ d                  Parity      rounds 60-79
+#define SHA1_F0(a,b,c,d,e,wk) do { \
+	uint32_t _t = ((a)<<5|(a)>>27) + ((d)^((b)&((c)^(d)))) + (e) + (wk); \
+	(e)=(d); (d)=(c); (c)=((b)<<30|(b)>>2); (b)=(a); (a)=_t; } while(0)
+#define SHA1_F1(a,b,c,d,e,wk) do { \
+	uint32_t _t = ((a)<<5|(a)>>27) + ((b)^(c)^(d))         + (e) + (wk); \
+	(e)=(d); (d)=(c); (c)=((b)<<30|(b)>>2); (b)=(a); (a)=_t; } while(0)
+#define SHA1_F2(a,b,c,d,e,wk) do { \
+	uint32_t _t = ((a)<<5|(a)>>27) + (((b)&(c))|((d)&((b)|(c)))) + (e) + (wk); \
+	(e)=(d); (d)=(c); (c)=((b)<<30|(b)>>2); (b)=(a); (a)=_t; } while(0)
+
+	// Rounds 0-19  (Choice)
+	SHA1_F0(a,b,c,d,e,WK[ 0]); SHA1_F0(a,b,c,d,e,WK[ 1]); SHA1_F0(a,b,c,d,e,WK[ 2]); SHA1_F0(a,b,c,d,e,WK[ 3]);
+	SHA1_F0(a,b,c,d,e,WK[ 4]); SHA1_F0(a,b,c,d,e,WK[ 5]); SHA1_F0(a,b,c,d,e,WK[ 6]); SHA1_F0(a,b,c,d,e,WK[ 7]);
+	SHA1_F0(a,b,c,d,e,WK[ 8]); SHA1_F0(a,b,c,d,e,WK[ 9]); SHA1_F0(a,b,c,d,e,WK[10]); SHA1_F0(a,b,c,d,e,WK[11]);
+	SHA1_F0(a,b,c,d,e,WK[12]); SHA1_F0(a,b,c,d,e,WK[13]); SHA1_F0(a,b,c,d,e,WK[14]); SHA1_F0(a,b,c,d,e,WK[15]);
+	SHA1_F0(a,b,c,d,e,WK[16]); SHA1_F0(a,b,c,d,e,WK[17]); SHA1_F0(a,b,c,d,e,WK[18]); SHA1_F0(a,b,c,d,e,WK[19]);
+
+	// Rounds 20-39  (Parity)
+	SHA1_F1(a,b,c,d,e,WK[20]); SHA1_F1(a,b,c,d,e,WK[21]); SHA1_F1(a,b,c,d,e,WK[22]); SHA1_F1(a,b,c,d,e,WK[23]);
+	SHA1_F1(a,b,c,d,e,WK[24]); SHA1_F1(a,b,c,d,e,WK[25]); SHA1_F1(a,b,c,d,e,WK[26]); SHA1_F1(a,b,c,d,e,WK[27]);
+	SHA1_F1(a,b,c,d,e,WK[28]); SHA1_F1(a,b,c,d,e,WK[29]); SHA1_F1(a,b,c,d,e,WK[30]); SHA1_F1(a,b,c,d,e,WK[31]);
+	SHA1_F1(a,b,c,d,e,WK[32]); SHA1_F1(a,b,c,d,e,WK[33]); SHA1_F1(a,b,c,d,e,WK[34]); SHA1_F1(a,b,c,d,e,WK[35]);
+	SHA1_F1(a,b,c,d,e,WK[36]); SHA1_F1(a,b,c,d,e,WK[37]); SHA1_F1(a,b,c,d,e,WK[38]); SHA1_F1(a,b,c,d,e,WK[39]);
+
+	// Rounds 40-59  (Majority)
+	SHA1_F2(a,b,c,d,e,WK[40]); SHA1_F2(a,b,c,d,e,WK[41]); SHA1_F2(a,b,c,d,e,WK[42]); SHA1_F2(a,b,c,d,e,WK[43]);
+	SHA1_F2(a,b,c,d,e,WK[44]); SHA1_F2(a,b,c,d,e,WK[45]); SHA1_F2(a,b,c,d,e,WK[46]); SHA1_F2(a,b,c,d,e,WK[47]);
+	SHA1_F2(a,b,c,d,e,WK[48]); SHA1_F2(a,b,c,d,e,WK[49]); SHA1_F2(a,b,c,d,e,WK[50]); SHA1_F2(a,b,c,d,e,WK[51]);
+	SHA1_F2(a,b,c,d,e,WK[52]); SHA1_F2(a,b,c,d,e,WK[53]); SHA1_F2(a,b,c,d,e,WK[54]); SHA1_F2(a,b,c,d,e,WK[55]);
+	SHA1_F2(a,b,c,d,e,WK[56]); SHA1_F2(a,b,c,d,e,WK[57]); SHA1_F2(a,b,c,d,e,WK[58]); SHA1_F2(a,b,c,d,e,WK[59]);
+
+	// Rounds 60-79  (Parity, same function as rounds 20-39)
+	SHA1_F1(a,b,c,d,e,WK[60]); SHA1_F1(a,b,c,d,e,WK[61]); SHA1_F1(a,b,c,d,e,WK[62]); SHA1_F1(a,b,c,d,e,WK[63]);
+	SHA1_F1(a,b,c,d,e,WK[64]); SHA1_F1(a,b,c,d,e,WK[65]); SHA1_F1(a,b,c,d,e,WK[66]); SHA1_F1(a,b,c,d,e,WK[67]);
+	SHA1_F1(a,b,c,d,e,WK[68]); SHA1_F1(a,b,c,d,e,WK[69]); SHA1_F1(a,b,c,d,e,WK[70]); SHA1_F1(a,b,c,d,e,WK[71]);
+	SHA1_F1(a,b,c,d,e,WK[72]); SHA1_F1(a,b,c,d,e,WK[73]); SHA1_F1(a,b,c,d,e,WK[74]); SHA1_F1(a,b,c,d,e,WK[75]);
+	SHA1_F1(a,b,c,d,e,WK[76]); SHA1_F1(a,b,c,d,e,WK[77]); SHA1_F1(a,b,c,d,e,WK[78]); SHA1_F1(a,b,c,d,e,WK[79]);
+
+#undef SHA1_F0
+#undef SHA1_F1
+#undef SHA1_F2
+
+	// Accumulate back into the reversed state storage.
+	// (After N=80 rounds of the explicit SHA-1 step, the rotating-array
+	//  equivalence gives: a↔d[4], b↔d[3], c↔d[2], d↔d[1], e↔d[0].)
+	st[4] += a; st[3] += b; st[2] += c; st[1] += d; st[0] += e;
+}
