+#if UTIL_SHA1_HAS_SHA_NI
+// SHA-1 block compression using Intel SHA extensions.
+// data[] already contains big-endian words (byte-swapped when LSB_FIRST).
+static inline void sha1_process_shani(std::array<uint32_t, 5> &st, uint32_t *data) noexcept
+{
+	__m128i ABCD, ABCD_SAVE, E0, E0_SAVE, E1;
+	__m128i MSG0, MSG1, MSG2, MSG3;
+
+	// MAME state order: st[4]=H0 ... st[0]=H4
+	ABCD = _mm_set_epi32(st[4], st[3], st[2], st[1]); // A,B,C,D in lanes 3..0
+	E0 = _mm_set_epi32(st[0], 0, 0, 0);               // E in lane 3
+
+	ABCD_SAVE = ABCD;
+	E0_SAVE = E0;
+
+	// Rounds 0-3
+	MSG0 = _mm_loadu_si128(reinterpret_cast<const __m128i *>(data + 0));
+	MSG0 = _mm_shuffle_epi32(MSG0, 0x1B); // SHA-NI attend W[0] en bits [127:96]
+	E0 = _mm_add_epi32(E0, MSG0);
+	E1 = ABCD;
+	ABCD = _mm_sha1rnds4_epu32(ABCD, E0, 0);
+
+	// Rounds 4-7
+	MSG1 = _mm_loadu_si128(reinterpret_cast<const __m128i *>(data + 4));
+	MSG1 = _mm_shuffle_epi32(MSG1, 0x1B);
+	E1 = _mm_sha1nexte_epu32(E1, MSG1);
+	E0 = ABCD;
+	ABCD = _mm_sha1rnds4_epu32(ABCD, E1, 0);
+	MSG0 = _mm_sha1msg1_epu32(MSG0, MSG1);
+
+	// Rounds 8-11
+	MSG2 = _mm_loadu_si128(reinterpret_cast<const __m128i *>(data + 8));
+	MSG2 = _mm_shuffle_epi32(MSG2, 0x1B);
+	E0 = _mm_sha1nexte_epu32(E0, MSG2);
+	E1 = ABCD;
+	ABCD = _mm_sha1rnds4_epu32(ABCD, E0, 0);
+	MSG1 = _mm_sha1msg1_epu32(MSG1, MSG2);
+	MSG0 = _mm_xor_si128(MSG0, MSG2);
+
+	// Rounds 12-15
+	MSG3 = _mm_loadu_si128(reinterpret_cast<const __m128i *>(data + 12));
+	MSG3 = _mm_shuffle_epi32(MSG3, 0x1B);
+	E1 = _mm_sha1nexte_epu32(E1, MSG3);
+	E0 = ABCD;
+	MSG0 = _mm_sha1msg2_epu32(MSG0, MSG3);
+	ABCD = _mm_sha1rnds4_epu32(ABCD, E1, 0);
+	MSG2 = _mm_sha1msg1_epu32(MSG2, MSG3);
+	MSG1 = _mm_xor_si128(MSG1, MSG3);
+
+	// Rounds 16-19
+	E0 = _mm_sha1nexte_epu32(E0, MSG0);
+	E1 = ABCD;
+	MSG1 = _mm_sha1msg2_epu32(MSG1, MSG0);
+	ABCD = _mm_sha1rnds4_epu32(ABCD, E0, 0);
+	MSG3 = _mm_sha1msg1_epu32(MSG3, MSG0);
+	MSG2 = _mm_xor_si128(MSG2, MSG0);
+
+	// Rounds 20-23
+	E1 = _mm_sha1nexte_epu32(E1, MSG1);
+	E0 = ABCD;
+	MSG2 = _mm_sha1msg2_epu32(MSG2, MSG1);
