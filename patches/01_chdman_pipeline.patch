+	const char *sha1_rounds = have_shani ? "SHA-NI" : (have_sse2 ? "SSE2" : "scalar");
+	// SHA1 byteswap: AVX2 > SSSE3 > scalar  (hashing.cpp dispatch)
+	const char *sha1_swap   = have_avx2 ? "AVX2" : (have_ssse3 ? "SSSE3" : "scalar");
