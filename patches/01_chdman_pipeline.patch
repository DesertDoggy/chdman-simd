+	else if (have_avx2)             flac = "AVX2";
+	else if (have_sse42)            flac = "SSE4.2";
+	else if (have_ssse3)            flac = "SSSE3";
+	else if (have_sse2)             flac = "SSE2";
+	else                            flac = "scalar";
