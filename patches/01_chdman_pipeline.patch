+	{
+		have_sse2  = (edx & (1U << 26)) != 0;
+		have_ssse3 = (ecx & (1U <<  9)) != 0;
+		have_sse42 = (ecx & (1U << 20)) != 0;
+		have_fma   = (ecx & (1U << 12)) != 0;
+
+		bool osxsave = (ecx & (1U << 27)) != 0;
+		bool cpuid_avx = (ecx & (1U << 28)) != 0;
+		if (osxsave && cpuid_avx)
+		{
+			// xgetbv via inline asm — avoids -mxsave requirement
+			uint32_t xcr0_lo = 0, xcr0_hi = 0;
+			__asm__ volatile("xgetbv" : "=a"(xcr0_lo), "=d"(xcr0_hi) : "c"(0U));
