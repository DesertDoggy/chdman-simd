+//-------------------------------------------------
+
+static std::string simd_active_string()
+{
+	unsigned int eax = 0, ebx = 0, ecx = 0, edx = 0;
+
+	bool have_sse2  = false;
+	bool have_ssse3 = false;
+	bool have_sse42 = false;
+	bool have_avx2  = false;
+	bool have_fma   = false;
+	bool have_shani = false;
+
