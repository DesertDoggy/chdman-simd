 //-------------------------------------------------
+//  do_verify - work queue callback (one per hunk)
+//-------------------------------------------------
+
+// Global hot-cache SHA1 state — single cursor across ALL batches.
+// Indexed by absolute hunk number: no cross-batch ordering bug possible.
+// Workers try to drain SHA1 immediately after decompression (data hot in L1/L2).
+// Main thread drains remainder after each batch (cold fallback, near-zero cost).
+
+struct verify_hunk_ctx
+{
+	chd_file**           chds;       // indexed by threadid
+	uint32_t             hunknum;    // premier hunk de cet item
+	uint32_t             count;      // nombre de hunks à traiter
+	uint8_t*             buffer;     // flat : count * hunk_bytes octets
+	uint32_t             hunk_bytes;
+	std::error_condition err;
+};
+
+static void* verify_hunk_cb(void* param, int threadid)
+{
+	auto* ctx = static_cast<verify_hunk_ctx*>(param);
+	for (uint32_t i = 0; i < ctx->count; i++)
+	{
+		ctx->err = ctx->chds[threadid]->read_hunk(ctx->hunknum + i, ctx->buffer + i * ctx->hunk_bytes);
+		if (ctx->err) break;
+	}
+	return nullptr;
+}
