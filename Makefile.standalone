# chdman standalone - MSYS2/MinGW64
# Run from the standalone output directory (created by build_standalone.sh)
# Build command: mingw32-make -j$(nproc)
#
# Prerequisites (MSYS2/MinGW64):
#   pacman -S mingw-w64-x86_64-gcc mingw-w64-x86_64-make mingw-w64-x86_64-cmake
#   pacman -S mingw-w64-x86_64-uasm   # optional — enables LZMA ASM decoder
#
# Run setup_zlibng.sh once before the first build.

# Toolchain — use whatever g++/gcc is first in PATH.
# If WinLibs and MSYS2 are both installed, ensure MSYS2 is first:
#   export PATH=/c/msys64/mingw64/bin:$PATH
CXX      := g++
CC       := gcc
AR       := ar

# --- Assembler auto-detection: UASM > ml64 (Windows/VS) > disabled ---
UASM_BIN := $(or $(wildcard C:/msys64/mingw64/bin/uasm.exe), $(shell which uasm 2>/dev/null || which uasm.exe 2>/dev/null))
ML64_BIN  := C:/Program Files/Microsoft Visual Studio/2022/Community/VC/Tools/MSVC/14.44.35207/bin/Hostx64/x64/ml64.exe

ifeq ($(OS),Windows_NT)
  ASM_ABI  =
else
  ASM_ABI  = -DABI_LINUX
endif

ifneq ($(UASM_BIN),)
  HAVE_LZMA_ASM := 1
  ASM_COMPILE    = $(UASM_BIN) -win64 -c $(ASM_ABI) -Fo$@ $<
else ifeq ($(OS),Windows_NT)
  ifneq ($(wildcard $(ML64_BIN)),)
    HAVE_LZMA_ASM := 1
    ASM_COMPILE    = "$(ML64_BIN)" /nologo /c /Fo$(subst /,\,$@) $(subst /,\,$<)
  endif
endif

TP       = 3rdparty
comma    := ,
S        = src
BUILDDIR = build/obj
TARGET   = chdman.exe
UTIL_SHA1_USE_SSE2 ?= 1

# zlib-ng (ZLIB_COMPAT=ON) — run setup_zlibng.sh once before building
ZLIBNG_BUILD = 3rdparty_extra/zlib-ng-2.3.3/build

# MARCH_BASE: minimum SSE2 — binary runs on all x86-64 CPUs.
# SIMD paths (SSSE3/AVX2/SHA-NI/FMA) are compiled per-file below and
# activated at runtime via CPUID dispatch. Set MARCH_BASE=native to
# optimize for the build machine instead.
MARCH_BASE ?= -march=x86-64 -msse2 -mtune=generic

CXXFLAGS = -std=c++17 -O3 $(MARCH_BASE) -g -DUTIL_SHA1_USE_SSE2=$(UTIL_SHA1_USE_SSE2) -DLSB_FIRST \
    -DHAVE_LZMA_ASM=$(or $(HAVE_LZMA_ASM),0) \
    -I$(S)/emu \
    -I$(S)/osd \
    -I$(S)/osd/windows \
    -I$(S)/osd/modules/file \
    -I$(S)/lib \
    -I$(S)/lib/util \
    -I$(TP) \
    -I$(TP)/lzma/C \
    -I$(TP)/utf8proc \
    -I$(TP)/expat/lib \
    -I$(ZLIBNG_BUILD) \
    -I$(TP)/zstd/lib \
    -I$(TP)/flac/include \
    -I$(TP)/flac/src/libFLAC/include \
    -DUTF8PROC_STATIC \
    -DFLAC__NO_DLL \
    -DCRLF=3 \
    -DOSD_WINDOWS \
    -DX64_WINDOWS_ABI \
    -DUNICODE -D_UNICODE \
    -D_WIN32_WINNT=0x0501 \
    -DWIN32_LEAN_AND_MEAN \
    -DNOMINMAX \
    -fpermissive \
    -Wall -Wextra

EXTRA_CXXFLAGS ?=
CXXFLAGS += $(EXTRA_CXXFLAGS)

EXTRA_CFLAGS ?=
CFLAGS += $(EXTRA_CFLAGS)

# Redirect warnings to build.log — keeps terminal output clean.
# Errors still appear on stderr.
LOG      = build/build.log
WARN_LOG = 2>>$(LOG)

CFLAGS = -O3 $(MARCH_BASE) -g \
    -I$(TP)/lzma/C \
    -I$(TP)/utf8proc \
    -I$(TP)/expat/lib \
    -I$(ZLIBNG_BUILD) \
    -I$(TP)/zstd/lib \
    -I$(TP)/flac/include \
    -I$(TP)/flac/src/libFLAC/include \
    -DXML_GE=1 -DXML_CONTEXT_BYTES=1024 -DUTF8PROC_STATIC -DZ7_ST \
    -DZLIB_CONST \
    -DXXH_NAMESPACE=ZSTD_ -DDEBUGLEVEL=0 -DZSTD_DISABLE_ASM \
    -DFLAC__NO_DLL -DNDEBUG -DHAVE_CONFIG_H -DENABLE_64_BIT_WORDS=1 \
    -DOGG_FOUND=0 -DFLAC__HAS_OGG=0 -DHAVE_LROUND=1 \
    -DHAVE_INTTYPES_H -DHAVE_STDBOOL_H -DHAVE_FSEEKO \
    -DFLAC__USE_AVX \
    -Wall -Wextra

LDFLAGS = -static -static-libstdc++ -static-libgcc -s \
    -lws2_32 -lwinmm -ladvapi32 -lshlwapi -lpsapi -liphlpapi -lshell32 -luserenv -lm \
    $(if $(HAVE_LZMA_ASM),-Wl$(comma)--allow-multiple-definition) \
    $(ZLIBNG_BUILD)/libz.a

# ---------------------------------------------------------------------------
# C++ sources
# ---------------------------------------------------------------------------

MAIN_SRCS = \
    $(S)/tools/chdman.cpp \
    $(S)/version.cpp

UTIL_SRCS = \
