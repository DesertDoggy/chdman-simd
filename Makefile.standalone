    $(S)/lib/util/avhuff.cpp \
    $(S)/lib/util/aviio.cpp \
    $(S)/lib/util/bitmap.cpp \
    $(S)/lib/util/cdrom.cpp \
    $(S)/lib/util/chd.cpp \
    $(S)/lib/util/chdcodec.cpp \
    $(S)/lib/util/corealloc.cpp \
    $(S)/lib/util/corefile.cpp \
    $(S)/lib/util/corestr.cpp \
    $(S)/lib/util/coreutil.cpp \
    $(S)/lib/util/delegate.cpp \
    $(S)/lib/util/disasmintf.cpp \
    $(S)/lib/util/dvdrom.cpp \
    $(S)/lib/util/dynamicclass.cpp \
    $(S)/lib/util/flac.cpp \
    $(S)/lib/util/harddisk.cpp \
    $(S)/lib/util/hash.cpp \
    $(S)/lib/util/hashing.cpp \
    $(S)/lib/util/huffman.cpp \
    $(S)/lib/util/ioprocs.cpp \
    $(S)/lib/util/ioprocsfilter.cpp \
    $(S)/lib/util/jedparse.cpp \
    $(S)/lib/util/language.cpp \
    $(S)/lib/util/md5.cpp \
    $(S)/lib/util/mfpresolve.cpp \
    $(S)/lib/util/msdib.cpp \
    $(S)/lib/util/nanosvg.cpp \
    $(S)/lib/util/opresolv.cpp \
    $(S)/lib/util/options.cpp \
    $(S)/lib/util/palette.cpp \
    $(S)/lib/util/path.cpp \
    $(S)/lib/util/path_to_regex.cpp \
    $(S)/lib/util/plaparse.cpp \
    $(S)/lib/util/png.cpp \
    $(S)/lib/util/simh_tape_file.cpp \
    $(S)/lib/util/strformat.cpp \
    $(S)/lib/util/timeconv.cpp \
    $(S)/lib/util/unicode.cpp \
    $(S)/lib/util/unzip.cpp \
    $(S)/lib/util/un7z.cpp \
    $(S)/lib/util/vbiparse.cpp \
    $(S)/lib/util/vecstream.cpp \
    $(S)/lib/util/wavwrite.cpp \
    $(S)/lib/util/xmlfile.cpp \
    $(S)/lib/util/zippath.cpp

OSD_SRCS = \
    $(S)/osd/osdcore.cpp \
    $(S)/osd/strconv.cpp \
    $(S)/osd/osdsync.cpp \
    $(S)/osd/modules/lib/osdlib_win32.cpp \
    $(S)/osd/windows/winutf8.cpp \
    $(S)/osd/modules/file/windir.cpp \
    $(S)/osd/modules/file/winfile.cpp \
    $(S)/osd/modules/file/winptty.cpp \
    $(S)/osd/modules/file/winsocket.cpp \
    $(S)/osd/windows/winutil.cpp

# ---------------------------------------------------------------------------
# C sources — 3rdparty compiled from source (no prebuilt .a required)
# ---------------------------------------------------------------------------

UTF8_CSRCS = \
    $(TP)/utf8proc/utf8proc.c

EXPAT_CSRCS = \
    $(TP)/expat/lib/xmlparse.c \
    $(TP)/expat/lib/xmlrole.c \
    $(TP)/expat/lib/xmltok.c

# LzmaDec.c is handled separately below (ASM override or C fallback)
LZMA_CSRCS = \
    $(TP)/lzma/C/7zAlloc.c \
    $(TP)/lzma/C/7zArcIn.c \
    $(TP)/lzma/C/7zBuf.c \
    $(TP)/lzma/C/7zBuf2.c \
    $(TP)/lzma/C/7zCrc.c \
    $(TP)/lzma/C/7zCrcOpt.c \
    $(TP)/lzma/C/7zDec.c \
    $(TP)/lzma/C/7zFile.c \
    $(TP)/lzma/C/7zStream.c \
    $(TP)/lzma/C/Aes.c \
    $(TP)/lzma/C/AesOpt.c \
    $(TP)/lzma/C/Alloc.c \
    $(TP)/lzma/C/Bcj2.c \
    $(TP)/lzma/C/Bra.c \
    $(TP)/lzma/C/Bra86.c \
    $(TP)/lzma/C/BraIA64.c \
    $(TP)/lzma/C/CpuArch.c \
    $(TP)/lzma/C/Delta.c \
    $(TP)/lzma/C/LzFind.c \
    $(TP)/lzma/C/LzFindOpt.c \
    $(TP)/lzma/C/Lzma2Dec.c \
    $(TP)/lzma/C/LzmaEnc.c \
    $(TP)/lzma/C/Ppmd7.c \
    $(TP)/lzma/C/Ppmd7Dec.c \
    $(TP)/lzma/C/Sha256.c \
    $(TP)/lzma/C/Sha256Opt.c \
    $(TP)/lzma/C/Sort.c

ZSTD_CSRCS = \
    $(TP)/zstd/lib/compress/hist.c \
    $(TP)/zstd/lib/common/debug.c \
    $(TP)/zstd/lib/common/entropy_common.c \
    $(TP)/zstd/lib/common/error_private.c \
    $(TP)/zstd/lib/common/fse_decompress.c \
    $(TP)/zstd/lib/common/pool.c \
    $(TP)/zstd/lib/common/threading.c \
    $(TP)/zstd/lib/common/xxhash.c \
    $(TP)/zstd/lib/common/zstd_common.c \
    $(TP)/zstd/lib/compress/fse_compress.c \
    $(TP)/zstd/lib/compress/huf_compress.c \
    $(TP)/zstd/lib/compress/zstd_compress.c \
    $(TP)/zstd/lib/compress/zstd_compress_literals.c \
    $(TP)/zstd/lib/compress/zstd_compress_sequences.c \
    $(TP)/zstd/lib/compress/zstd_compress_superblock.c \
    $(TP)/zstd/lib/compress/zstd_double_fast.c \
    $(TP)/zstd/lib/compress/zstd_fast.c \
    $(TP)/zstd/lib/compress/zstd_lazy.c \
    $(TP)/zstd/lib/compress/zstd_ldm.c \
    $(TP)/zstd/lib/compress/zstdmt_compress.c \
    $(TP)/zstd/lib/compress/zstd_opt.c \
    $(TP)/zstd/lib/decompress/huf_decompress.c \
    $(TP)/zstd/lib/decompress/zstd_ddict.c \
    $(TP)/zstd/lib/decompress/zstd_decompress.c \
    $(TP)/zstd/lib/decompress/zstd_decompress_block.c

FLAC_CSRCS = \
    $(TP)/flac/src/libFLAC/bitmath.c \
    $(TP)/flac/src/libFLAC/bitreader.c \
    $(TP)/flac/src/libFLAC/bitwriter.c \
    $(TP)/flac/src/libFLAC/crc.c \
    $(TP)/flac/src/libFLAC/cpu.c \
    $(TP)/flac/src/libFLAC/fixed.c \
    $(TP)/flac/src/libFLAC/fixed_intrin_avx2.c \
    $(TP)/flac/src/libFLAC/fixed_intrin_sse2.c \
    $(TP)/flac/src/libFLAC/fixed_intrin_sse42.c \
    $(TP)/flac/src/libFLAC/fixed_intrin_ssse3.c \
    $(TP)/flac/src/libFLAC/float.c \
    $(TP)/flac/src/libFLAC/format.c \
    $(TP)/flac/src/libFLAC/lpc.c \
    $(TP)/flac/src/libFLAC/lpc_intrin_avx2.c \
    $(TP)/flac/src/libFLAC/lpc_intrin_fma.c \
    $(TP)/flac/src/libFLAC/lpc_intrin_neon.c \
    $(TP)/flac/src/libFLAC/lpc_intrin_sse2.c \
    $(TP)/flac/src/libFLAC/lpc_intrin_sse41.c \
    $(TP)/flac/src/libFLAC/md5.c \
    $(TP)/flac/src/libFLAC/memory.c \
    $(TP)/flac/src/libFLAC/stream_decoder.c \
    $(TP)/flac/src/libFLAC/stream_encoder.c \
    $(TP)/flac/src/libFLAC/stream_encoder_framing.c \
    $(TP)/flac/src/libFLAC/stream_encoder_intrin_avx2.c \
    $(TP)/flac/src/libFLAC/stream_encoder_intrin_sse2.c \
    $(TP)/flac/src/libFLAC/stream_encoder_intrin_ssse3.c \
    $(TP)/flac/src/libFLAC/window.c \
    $(TP)/flac/src/share/win_utf8_io/win_utf8_io.c

# ---------------------------------------------------------------------------
# Object lists
# ---------------------------------------------------------------------------

ALL_SRCS = $(MAIN_SRCS) $(UTIL_SRCS) $(OSD_SRCS)
CXX_OBJS = $(addprefix $(BUILDDIR)/,$(patsubst %.cpp,%.o,$(ALL_SRCS)))

ALL_CSRCS = $(UTF8_CSRCS) $(EXPAT_CSRCS) $(LZMA_CSRCS) $(ZSTD_CSRCS) $(FLAC_CSRCS)
C_OBJS    = $(addprefix $(BUILDDIR)/,$(patsubst %.c,%.o,$(ALL_CSRCS)))

ifeq ($(HAVE_LZMA_ASM),1)
  # LzmaDec.c recompiled with Z7_LZMA_DEC_OPT (declares external ASM impl)
  LZMA_OPT_OBJ   = $(BUILDDIR)/$(TP)/lzma/C/LzmaDec.OPT.o
  LZMA_ASM_OBJ   = $(BUILDDIR)/$(TP)/lzma/Asm/x86/LzmaDecOpt.o
  LZFIND_ASM_OBJ = $(BUILDDIR)/$(TP)/lzma/Asm/x86/LzFindOpt.o
  $(info LZMA ASM decoder enabled ($(if $(UASM_BIN),uasm,ml64)))
else
  # LzmaDec.c compiled normally — C fallback
  LZMA_OPT_OBJ   = $(BUILDDIR)/$(TP)/lzma/C/LzmaDec.o
  LZMA_ASM_OBJ   =
  LZFIND_ASM_OBJ =
  $(info LZMA ASM decoder disabled - C fallback)
endif

OBJS = $(CXX_OBJS) $(LZMA_OPT_OBJ) $(LZMA_ASM_OBJ) $(LZFIND_ASM_OBJ) $(C_OBJS)

# ---------------------------------------------------------------------------
# Targets
# ---------------------------------------------------------------------------

.PHONY: all clean check_zlibng

all: check_zlibng $(TARGET)
	@echo "Build complete: $(TARGET)"
	@echo "Warnings saved to: $(LOG)"

check_zlibng:
	@test -f $(ZLIBNG_BUILD)/libz.a || \
	  (echo "ERROR: zlib-ng not built. Run: bash setup_zlibng.sh" && exit 1)

$(TARGET): $(OBJS)
	$(CXX) $(OBJS) -o $@ $(LDFLAGS)

$(BUILDDIR)/%.o: %.cpp
	@mkdir -p $(dir $@) $(dir $(LOG))
	$(CXX) $(CXXFLAGS) -c $< -o $@ $(WARN_LOG)

$(BUILDDIR)/%.o: %.c
	@mkdir -p $(dir $@) $(dir $(LOG))
	$(CC) $(CFLAGS) -c $< -o $@ $(WARN_LOG)

# ---------------------------------------------------------------------------
# Per-file SIMD overrides — compile with required ISA flags so runtime
# dispatch paths are compiled in even when MARCH_BASE=x86-64 (SSE2 only).
# Each function is guarded by #if UTIL_SHA1_HAS_xxx / FLAC cpu detection,
# so it is only called when CPUID confirms the feature is available.
# ---------------------------------------------------------------------------

# hashing.cpp: SSSE3 byte-swap + AVX2 byte-swap + SHA-NI rounds
$(BUILDDIR)/$(S)/lib/util/hashing.o: $(S)/lib/util/hashing.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -mssse3 -mavx2 -msha -c $< -o $@ $(WARN_LOG)

# FLAC AVX2 intrinsics
$(BUILDDIR)/$(TP)/flac/src/libFLAC/fixed_intrin_avx2.o: $(TP)/flac/src/libFLAC/fixed_intrin_avx2.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -mavx2 -c $< -o $@ $(WARN_LOG)

$(BUILDDIR)/$(TP)/flac/src/libFLAC/lpc_intrin_avx2.o: $(TP)/flac/src/libFLAC/lpc_intrin_avx2.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -mavx2 -c $< -o $@ $(WARN_LOG)

$(BUILDDIR)/$(TP)/flac/src/libFLAC/stream_encoder_intrin_avx2.o: $(TP)/flac/src/libFLAC/stream_encoder_intrin_avx2.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -mavx2 -c $< -o $@ $(WARN_LOG)

# FLAC FMA (requires AVX for ymm registers)
$(BUILDDIR)/$(TP)/flac/src/libFLAC/lpc_intrin_fma.o: $(TP)/flac/src/libFLAC/lpc_intrin_fma.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -mavx2 -mfma -c $< -o $@ $(WARN_LOG)

# FLAC SSE4.2
$(BUILDDIR)/$(TP)/flac/src/libFLAC/fixed_intrin_sse42.o: $(TP)/flac/src/libFLAC/fixed_intrin_sse42.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -msse4.2 -c $< -o $@ $(WARN_LOG)

# FLAC SSE4.1
$(BUILDDIR)/$(TP)/flac/src/libFLAC/lpc_intrin_sse41.o: $(TP)/flac/src/libFLAC/lpc_intrin_sse41.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -msse4.1 -c $< -o $@ $(WARN_LOG)

# FLAC SSSE3
$(BUILDDIR)/$(TP)/flac/src/libFLAC/fixed_intrin_ssse3.o: $(TP)/flac/src/libFLAC/fixed_intrin_ssse3.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -mssse3 -c $< -o $@ $(WARN_LOG)

$(BUILDDIR)/$(TP)/flac/src/libFLAC/stream_encoder_intrin_ssse3.o: $(TP)/flac/src/libFLAC/stream_encoder_intrin_ssse3.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -mssse3 -c $< -o $@ $(WARN_LOG)

# LzmaDec.c — special rules (ASM path or C fallback)
ifeq ($(HAVE_LZMA_ASM),1)
$(LZMA_OPT_OBJ): $(TP)/lzma/C/LzmaDec.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -DZ7_LZMA_DEC_OPT -c $< -o $@ $(WARN_LOG)

$(LZMA_ASM_OBJ): $(TP)/lzma/Asm/x86/LzmaDecOpt.asm
	@mkdir -p $(dir $@)
	$(ASM_COMPILE)

$(LZFIND_ASM_OBJ): $(TP)/lzma/Asm/x86/LzFindOpt.asm
	@mkdir -p $(dir $@)
	$(ASM_COMPILE)
else
$(LZMA_OPT_OBJ): $(TP)/lzma/C/LzmaDec.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@ $(WARN_LOG)
endif

clean:
	rm -rf $(BUILDDIR) $(TARGET)
